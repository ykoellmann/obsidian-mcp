# Required: absolute path to your Obsidian vault
VAULT_PATH=/path/to/your/vault

# Set to true to disable all write operations
READ_ONLY=false

# Comma-separated relative paths where writes are allowed (empty = everywhere)
WRITE_PATHS=

# Comma-separated paths to exclude from listing/search
EXCLUDE_PATHS=private,.obsidian,.trash

# Transport mode: "stdio" (default, local use), "http" (remote/network use,
# recommended — see README "Remote Setup" for why), or "sse" (legacy,
# kept for older clients; has known issues with claude.ai's OAuth connector)
TRANSPORT=stdio

# Host/port to bind for network transports (sse/streamable-http). Ignored for stdio.
# Default 0.0.0.0 so the server is reachable from outside a Docker container.
HOST=0.0.0.0
PORT=8000

# API key for network transports (sse/streamable-http). Required whenever
# TRANSPORT is not "stdio", unless GitHub OAuth (below) is configured instead
# — the server refuses to start unauthenticated over the network. Works
# alongside OAuth if both are set; neither disables the other.
# All requests must include: Authorization: Bearer <your-key>
# Generate with: openssl rand -hex 32
API_KEY=

# The server's own externally-reachable base URL (e.g. behind a reverse
# proxy or Cloudflare Tunnel), no trailing slash.
# - Optional otherwise: create_attachment_token_tool includes a ready-to-use
#   "url" in its result instead of the caller having to know host/port/scheme.
# - Required if GitHub OAuth (below) is configured: used as the OAuth
#   callback base URL.
# e.g. https://obsidian.example.com
PUBLIC_BASE_URL=

# Optional: GitHub OAuth as a second, independent auth variant, in addition
# to API_KEY. Needed because claude.ai (Web/Mobile Custom Connector) only
# supports OAuth for MCP connectors — no bearer-token field. Runs alongside
# API_KEY; existing Claude Code/Desktop/curl setups keep working unchanged.
#
# Setup: GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
#   Homepage URL:            <PUBLIC_BASE_URL>
#   Authorization callback:  <PUBLIC_BASE_URL>/auth/callback
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
#
# Required as soon as the two vars above are set: at least one GitHub
# username, comma-separated. Only these accounts may authenticate — anyone
# else's GitHub login is rejected. There is no "allow everyone" fallback.
# OAUTH_GITHUB_ALLOWED_LOGINS=your-github-username
#
# Optional: FastMCP persists OAuth client registrations/tokens under its own
# data directory (defaults to a platformdirs path outside any Docker volume).
# Point it at a mounted, persistent path so logins survive container
# restarts — otherwise every restart forces every connected client to
# re-authenticate.
# FASTMCP_HOME=/data/fastmcp
