# Required: absolute path to your Obsidian vault
VAULT_PATH=/path/to/your/vault

# Set to true to disable all write operations
# Safe network-oriented default. Set false only with a narrow WRITE_PATHS, or
# explicitly accept unrestricted compatibility behavior when WRITE_PATHS is empty.
READ_ONLY=true

# Optional comma-separated read allowlist (empty = the whole vault except
# DENY_READ_PATHS). Rules use the same exact/trailing-slash recursive syntax.
# READ_PATHS=AI-Memory/,AI-Output/

# Comma-separated relative paths where writes are allowed (empty = everywhere
# only when READ_ONLY=false). A trailing slash means directory descendants;
# no trailing slash means the exact path only.
WRITE_PATHS=AI-Memory/,AI-Output/

# Paths that no MCP operation may read. These are security boundaries, unlike
# EXCLUDE_PATHS. Rules are rooted at the vault; a trailing slash includes all
# descendants, while a rule without one matches only that exact path.
DENY_READ_PATHS=.obsidian/,.trash/

# Paths that cannot be written, even when beneath WRITE_PATHS.
DENY_WRITE_PATHS=.obsidian/,.trash/,_AI_INSTRUCTIONS.md

# Use a case-sensitive filesystem for authoritative path scopes. Deny rules
# are case-folded defensively for common local case-insensitive filesystems.

# Permanent deletion is disabled unless explicitly opted in.
ALLOW_PERMANENT_DELETE=false

# Maximum size accepted for MCP and HTTP attachment writes (default 25 MiB).
MAX_ATTACHMENT_BYTES=26214400

# Optimistic concurrency. When true, replacing an existing note through
# write_note_tool requires the revision returned by read_note_tool. Incremental
# read-modify-write tools always protect their own read, and accept an optional
# revision to pin the edit to an earlier client read.
REQUIRE_WRITE_PRECONDITIONS=false

# Watcher events are debounced to absorb sync write storms. A full SHA-256
# reconciliation of readable Markdown notes (attachments excluded) repairs
# missed filesystem events every 15 minutes by default.
WATCHER_DEBOUNCE_MS=100
INDEX_RECONCILE_INTERVAL=900

# Lock files are kept outside the synced vault. Native default:
# <system-temp>/obsidian-mcp-locks. Docker explicitly uses /data/locks;
# set LOCK_PATH for another deployment. A configured lock-path creation
# failure is fatal rather than falling back into the vault.
# LOCK_PATH=/data/locks

# Audit records are stored outside the synced vault. The native default is
# <LOCK_PATH>/audit.jsonl; Docker uses the persistent /data mount.
# AUDIT_LOG_PATH=/data/audit.jsonl

# Rooted paths to exclude from listing/search/indexing (not access control).
# A trailing slash includes descendants; without one only the exact path matches.
EXCLUDE_PATHS=private/,.obsidian/,.trash/

# New MCP files/directories use normal 0666/0777 creation modes filtered by
# the process umask. Overwrites preserve the existing file's permission bits.
# Run MCP and the sync daemon with compatible PUID/PGID and umask settings.

# Tools advertised to MCP clients: "full" permits all 48 base tools;
# "focused" permits the curated common note-memory/writing surface. Separate
# high-impact gates below can further reduce either profile.
# This changes visibility, not filesystem permissions. Reconnect clients after
# changing it so they refresh tools/list.
TOOL_PROFILE=full

# Multiple vaults instead of one (e.g. a private vault + a separate work
# vault, each only reachable by its own API key/GitHub login): set this to
# the path of a vaults.json file. VAULT_PATH/READ_PATHS/WRITE_PATHS/
# DENY_READ_PATHS/DENY_WRITE_PATHS/EXCLUDE_PATHS and identity settings
# then come from that file. See README "Multi-Vault Setup" and
# vaults.json.example. Leave unset for the normal single-vault setup above.
# VAULTS_CONFIG=/path/to/vaults.json

# Optional plugin-format tool groups — each disabled by default (opt-in).
# Disabled tools aren't just refused at call time, they're never registered,
# so they don't appear in a connected client's tool list at all.
# ENABLE_CANVAS=true      # .canvas file tools
# ENABLE_EXCALIDRAW=true  # *.excalidraw.md file tools
# ENABLE_KANBAN=true      # Kanban board tools
# ENABLE_BASES=true       # .base file tools (Obsidian core plugin, 1.9.0+)

# High-impact mutation tools are absent from the MCP tool list by default.
# ENABLE_MOVE=true
# ENABLE_FOLDER_RENAME=true
# ENABLE_BULK_REPLACE=true
# ENABLE_DELETE=true

# Transport mode: "stdio" (default, local use), "http" (remote/network use,
# recommended — see README "Remote Setup" for why), or "sse" (legacy,
# kept for older clients; has known issues with claude.ai's OAuth connector)
TRANSPORT=stdio

# Host/port to bind for network transports (sse/streamable-http). Ignored for stdio.
# Default 0.0.0.0 so the server is reachable from outside a Docker container.
HOST=0.0.0.0
PORT=8000

# Hardened home-server Compose profile only: bind paths and container identity.
# Prepare AI_MEMORY_PATH/AI_OUTPUT_PATH inside HOST_VAULT_PATH and make
# MCP_DATA_PATH writable by PUID:PGID before starting the stack.
# HOST_VAULT_PATH=/srv/obsidian-vault
# AI_MEMORY_PATH=AI-Memory
# AI_OUTPUT_PATH=AI-Output
# MCP_DATA_PATH=/srv/obsidian-mcp-data
# PUID=1000
# PGID=1000
# CLOUDFLARE_TUNNEL_TOKEN=
# CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:<reviewed-digest>

# API key for network transports (sse/streamable-http). Required whenever
# TRANSPORT is not "stdio", unless this app's GitHub OAuth (below) is configured
# instead. Cloudflare Access Managed OAuth does not inject this origin key.
# Works alongside app OAuth if both are set; neither disables the other.
# All requests must include: Authorization: Bearer <your-key>
# Generate with: openssl rand -hex 32
API_KEY=

# The server's own externally-reachable base URL (e.g. behind a reverse
# proxy or Cloudflare Tunnel), no trailing slash.
# - Optional otherwise: create_attachment_token_tool includes a ready-to-use
#   "url" in its result instead of the caller having to know host/port/scheme.
# - Required if GitHub OAuth (below) is configured: used as the OAuth
#   callback base URL.
# e.g. https://obsidian.example.com
PUBLIC_BASE_URL=

# Optional: GitHub OAuth as a second, independent auth variant, in addition
# to API_KEY. Needed because claude.ai (Web/Mobile Custom Connector) only
# supports OAuth for MCP connectors — no bearer-token field. Runs alongside
# API_KEY; existing Claude Code/Desktop/curl setups keep working unchanged.
#
# Setup: GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
#   Homepage URL:            <PUBLIC_BASE_URL>
#   Authorization callback:  <PUBLIC_BASE_URL>/auth/callback
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
#
# Required as soon as the two vars above are set: at least one GitHub
# username, comma-separated. Only these accounts may authenticate — anyone
# else's GitHub login is rejected. There is no "allow everyone" fallback.
# OAUTH_GITHUB_ALLOWED_LOGINS=your-github-username
#
# Optional: FastMCP persists OAuth client registrations/tokens under its own
# data directory (defaults to a platformdirs path outside any Docker volume).
# Point it at a mounted, persistent path so logins survive container
# restarts — otherwise every restart forces every connected client to
# re-authenticate.
# FASTMCP_HOME=/data/fastmcp
