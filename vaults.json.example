{
  "vaults": {
    "private": {
      "path": "/vaults/private",
      "description": "Personal PARA vault (00-Inbox, 01-Projects, ...)",
      "exclude_paths": ["private", ".obsidian"]
    },
    "monari": {
      "path": "/vaults/monari",
      "description": "Work vault for the monari shopfitting company",
      "write_paths": ["02-Areas/monari/"],
      "exclude_paths": [".obsidian"],
      "read_only": false
    }
  },
  "identities": [
    {
      "type": "api_key",
      "value": "sk-replace-with-a-real-generated-key",
      "vaults": ["private"]
    },
    {
      "type": "github_login",
      "value": "your-github-username",
      "vaults": ["private", "monari"],
      "default": "private"
    },
    {
      "type": "github_login",
      "value": "your-coworkers-github-username",
      "vaults": ["monari"]
    }
  ]
}
